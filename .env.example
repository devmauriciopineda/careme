# Local development defaults. Keep the real .env untracked.
# The assistant is the real one by default: set CAREME_LLM_API_KEY below, or the
# backend will refuse to start. Use CAREME_LLM_MODE=fake to work without a credential.
CAREME_LLM_MODE=openai
CAREME_LLM_BASE_URL=https://api.deepseek.com
CAREME_LLM_MODEL=deepseek-flash
CAREME_LLM_API_KEY=
CAREME_LLM_CONNECT_TIMEOUT=PT5S
CAREME_LLM_READ_TIMEOUT=PT30S
